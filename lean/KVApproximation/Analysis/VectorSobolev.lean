module

public import TauCeti.Analysis.Sobolev.W1p.Basic
public import Mathlib.Analysis.InnerProductSpace.PiL2
public import Mathlib.MeasureTheory.Measure.Haar.InnerProductSpace

/-!
# Vector-valued Sobolev spaces with zero boundary values
-/

@[expose] public section

noncomputable section

open MeasureTheory TopologicalSpace

namespace KVApproximation.Analysis

/-- Section 2.1: Euclidean physical displacement and spatial coordinates. -/
abbrev PhysicalSpace (d : ℕ) := EuclideanSpace ℝ (Fin d)

/-- Theorem 3.1: vector `H¹(Ω)` with the Euclidean sum of the scalar
value-gradient norms. The gradients satisfy the distributional identities
in `TauCeti.W1p`. -/
abbrev VectorH1 {d : ℕ} (Ω : Opens (PhysicalSpace d)) :=
  PiLp 2 (fun _ : Fin d => TauCeti.W1p volume Ω 2)

/-- Theorem 3.1, spatial Sobolev space: jets represented by a smooth,
compactly supported displacement in the material domain. -/
def smoothCompactJets {d : ℕ} (Ω : Opens (PhysicalSpace d)) : Set (VectorH1 Ω) :=
  {u | ∃ φ : PhysicalSpace d → PhysicalSpace d,
    ContDiff ℝ (⊤ : ℕ∞) φ ∧ HasCompactSupport φ ∧ tsupport φ ⊆ (Ω : Set (PhysicalSpace d)) ∧
      ∀ i : Fin d, TauCeti.W1p.value (u i) =ᵐ[volume.restrict Ω] fun x => φ x i}

/-- Theorem 3.1: the closed Sobolev subspace generated by smooth
compactly supported displacements. -/
def zeroBoundarySubmodule {d : ℕ} (Ω : Opens (PhysicalSpace d)) :
    ClosedSubmodule ℝ (VectorH1 Ω) :=
  (Submodule.span ℝ (smoothCompactJets Ω)).closure

/-- Theorem 3.1: `H¹₀(Ω;ℝᵈ)`, with its full Hilbert Sobolev norm. -/
abbrev ZeroBoundaryH1 {d : ℕ} (Ω : Opens (PhysicalSpace d)) :=
  (zeroBoundarySubmodule Ω).toSubmodule

/-- Theorem 3.1: the inherited normed additive group on `H¹₀(Ω;ℝᵈ)`. -/
instance ZeroBoundaryH1.instNormedAddCommGroup {d : ℕ}
    (Ω : Opens (PhysicalSpace d)) : NormedAddCommGroup (ZeroBoundaryH1 Ω) :=
  Submodule.normedAddCommGroup (𝕜 := ℝ) (E := VectorH1 Ω)
    (zeroBoundarySubmodule Ω).toSubmodule

instance {d : ℕ} (Ω : Opens (PhysicalSpace d)) :
    InnerProductSpace ℝ (ZeroBoundaryH1 Ω) :=
  Submodule.innerProductSpace (𝕜 := ℝ) (E := VectorH1 Ω)
    (zeroBoundarySubmodule Ω).toSubmodule

instance {d : ℕ} (Ω : Opens (PhysicalSpace d)) : CompleteSpace (ZeroBoundaryH1 Ω) :=
  (zeroBoundarySubmodule Ω).isClosed.completeSpace_coe

/-- Theorem 3.1, weak displacement: a representative of the value field. -/
def VectorH1.value {d : ℕ} {Ω : Opens (PhysicalSpace d)}
    (u : VectorH1 Ω) (x : PhysicalSpace d) : PhysicalSpace d :=
  WithLp.toLp 2 (fun i => TauCeti.W1p.value (u i) x)

/-- Theorem 3.1, strain: the `j`-th weak derivative of displacement
component `i`, before taking its symmetric part. -/
def VectorH1.gradientEntry {d : ℕ} {Ω : Opens (PhysicalSpace d)}
    (u : VectorH1 Ω) (x : PhysicalSpace d) (i j : Fin d) : ℝ :=
  TauCeti.W1p.gradient (u i) x j

end KVApproximation.Analysis
