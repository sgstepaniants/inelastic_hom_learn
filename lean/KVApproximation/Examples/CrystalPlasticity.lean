module

public import Mathlib.Analysis.Normed.Algebra.MatrixExponential
public import Mathlib.Analysis.SpecialFunctions.Pow.Real
public import Mathlib.Basic.Real.Sign
public import Mathlib.LinearAlgebra.CrossProduct

/-!
# Crystal-plasticity constitutive quantities
-/

@[expose] public section

noncomputable section

namespace KVApproximation.Examples.CrystalPlasticity

/-- Appendix D.1 (`app:cp3d_constitutive`): real three-dimensional matrix fields. -/
abbrev Mat3 := Matrix (Fin 3) (Fin 3) ℝ

/-- Appendix D.1: elastic Green–Lagrange strain. -/
def greenStrain (Fe : Mat3) : Mat3 := (1 / 2 : ℝ) • (Fe.transpose * Fe - 1)

/-- Appendix D.1: cubic stiffness in crystal coordinates, in common units
for `C11`, `C12`, and `C44`. The off-diagonal strain components are tensorial. -/
def cubicStress (C11 C12 C44 : ℝ) (E : Mat3) : Mat3 :=
  fun i j => if i = j then C11 * E i i + C12 * ∑ k ∈ Finset.univ.erase i, E k k
    else 2 * C44 * E i j

/-- Appendix D.1: the stated copper single-crystal stress, in GPa. -/
def copperStress (E : Mat3) : Mat3 := cubicStress (1689 / 10) (1218 / 10) (758 / 10) E

/-- Appendix D.1: first Piola–Kirchhoff stress. The plastic distortion is
assumed invertible in its physical use. -/
def firstPiola (Fe Se Fp : Mat3) : Mat3 := Fe * Se * (Fp⁻¹).transpose

/-- Appendix D.1: scalar resolved shear, using the stated small-elastic-strain
driving-stress approximation. The paper's juxtaposition denotes contraction. -/
def resolvedShear (Se : Mat3) (s m : Fin 3 → ℝ) : ℝ :=
  ∑ i, ∑ j, Se i j * s i * m j

/-- Appendix D.1: slip rate on one slip system. -/
def slipRate (referenceRate : ℝ) (exponent : ℕ) (shear resistance : ℝ) : ℝ :=
  referenceRate * |shear / resistance| ^ exponent * Real.sign shear

/-- Appendix D.1: the reference shear rate and exponent used for copper. -/
def copperSlipRate (shear resistance : ℝ) : ℝ := slipRate (3 / 1000) 20 shear resistance

/-- Appendix D.1: interaction coefficients ordered as self, coplanar,
collinear, Hirth, glissile I, glissile II, and Lomer. The appendix does not
specify a numbering of the full twelve-by-twelve interaction matrix. -/
def fccInteractionWeights : Fin 7 → ℝ :=
  ![1, 1, 5123 / 1000, 574 / 1000, 1123 / 1000, 1123 / 1000, 1]

/-- Appendix D.1: plastic velocity gradient for the twelve FCC slip systems. -/
def plasticVelocity (rates : Fin 12 → ℝ) (direction normal : Fin 12 → Fin 3 → ℝ) : Mat3 :=
  fun i j => ∑ α : Fin 12, rates α * direction α i * normal α j

/-- Appendix D.1: the right-hand side of the plastic-distortion evolution. -/
def plasticRate (rates : Fin 12 → ℝ) (direction normal : Fin 12 → Fin 3 → ℝ)
    (Fp : Mat3) : Mat3 := plasticVelocity rates direction normal * Fp

/-- Appendix D.1: hardening rate, including self and latent interactions.
The saturation exponent is a real power of a nonnegative base. -/
def hardeningRate (scale saturation exponent : ℝ) (resistance : Fin 12 → ℝ)
    (interaction : Matrix (Fin 12) (Fin 12) ℝ) (rates : Fin 12 → ℝ) (α : Fin 12) : ℝ :=
  scale * Real.sign (1 - resistance α / saturation) *
    |1 - resistance α / saturation| ^ exponent * ∑ β, interaction α β * |rates β|

/-- Appendix D.1: the hardening law with the stated saturation exponent. -/
def copperHardeningRate (scale saturation : ℝ) (resistance : Fin 12 → ℝ)
    (interaction : Matrix (Fin 12) (Fin 12) ℝ) (rates : Fin 12 → ℝ) (α : Fin 12) : ℝ :=
  hardeningRate scale saturation (3 / 5) resistance interaction rates α

/-- Appendix D.2: initial resistance, saturation resistance, and hardening
scale in GPa, using the two prescribed grainwise scale factors. -/
def copperGrainParameters (resistanceScale hardeningScale : ℝ) : ℝ × ℝ × ℝ :=
  ((31 / 1000) * resistanceScale, (241 / 2500) * resistanceScale,
    (7 / 20) * hardeningScale)

/-- Appendix D.3 (`app:cp3d_loading_sampling`): the matrix implementing
cross product with the rotation vector. -/
def skew (w : Fin 3 → ℝ) : Mat3 :=
  !![0, -w 2, w 1; w 2, 0, -w 0; -w 1, w 0, 0]

/-- Appendix D.3: the rotation generated by the skew matrix. -/
def rotation (w : Fin 3 → ℝ) : Mat3 := NormedSpace.exp (skew w)

/-- Appendix D.3: volumetric and deviatoric logarithmic strain. -/
def logarithmicStrain (volumeLog : ℝ) (deviator : Mat3) : Mat3 :=
  (volumeLog / 3) • (1 : Mat3) + deviator

/-- Appendix D.3: coordinates in the trace-free symmetric basis
`E₁₁-E₃₃`, `E₂₂-E₃₃`, `E₁₂+E₂₁`, `E₁₃+E₃₁`, `E₂₃+E₃₂`. -/
def deviatoricFromCoordinates (c : Fin 5 → ℝ) : Mat3 :=
  !![c 0, c 2, c 3; c 2, c 1, c 4; c 3, c 4, -c 0 - c 1]

/-- Appendix D.3: the five independent deviatoric-strain coordinates. -/
def deviatoricCoordinates (D : Mat3) : Fin 5 → ℝ :=
  ![D 0 0, D 1 1, D 0 1, D 0 2, D 1 2]

/-- Appendix D.3: the sampled deformation gradient reconstructed from
rotation, volume, and deviatoric stretch. -/
def deformation (w : Fin 3 → ℝ) (volumeLog : ℝ) (deviator : Mat3) : Mat3 :=
  rotation w * NormedSpace.exp (logarithmicStrain volumeLog deviator)

end KVApproximation.Examples.CrystalPlasticity
